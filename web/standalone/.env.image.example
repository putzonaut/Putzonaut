# The installation artifact replaces this tag with the tested manifest digest.
PUTZONAUT_IMAGE=ghcr.io/putzonaut/putzonaut:latest
APP_ORIGIN=https://app.putzonaut.de
WEBSITE_ORIGIN=https://putzonaut.de
# Generate once with: openssl rand -hex 48
BETTER_AUTH_SECRET=
MAIL_FROM=Putzonaut <info@putzonaut.de>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Copy the SMTP login and SMTP key from Brevo. Keep the key private.
SMTP_USER=
SMTP_PASSWORD=
# Only needed for compose.tunnel.yaml. Use the existing connector's network.
PUTZONAUT_TUNNEL_NETWORK=
# Leave empty unless the proxy's exact address and overwritten X-Real-IP are known.
TRUSTED_PROXY_IPS=
